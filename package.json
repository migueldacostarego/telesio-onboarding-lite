{
  "name": "telesio-onboarding-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Telesio Onboarding Lite : demande RH, validation direction, création du compte Entra et activation le jour J.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm --prefix web run build",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "lint": "eslint . && npm --prefix web run lint",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "vitest run && npm --prefix web test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "applicationinsights": "3.17.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
