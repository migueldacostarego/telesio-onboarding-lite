# Aucune valeur secrète ici : l'authentification Graph passe par l'identité managée.
PORT=3000

# Valideur (routes Direction fermées, 503, tant qu'ils sont vides)
DIRECTION_TYPE=            # user | group
DIRECTION_OBJECT_ID=       # objectId Entra de la personne ou du groupe

# Dossier SharePoint (valider répond 503 tant qu'ils sont vides)
SHAREPOINT_SITE_ID=        # hostname,siteCollectionId,webId
SHAREPOINT_DRIVE_ID=       # id Graph de la bibliothèque (drive) du site
SHAREPOINT_FOLDER_PATTERN= # défaut : {nom} {prenom} (champs : {nom}, {prenom}, {id})

# Licences proposées à RH (demandes et validation répondent 503 tant qu'elles sont vides)
LICENSES=                  # JSON : [{"skuId":"<GUID>","libelle":"Business Premium","groupId":"<GUID>"}] ; un groupe par SKU
ENTRA_LICENSE_EXTENSION=   # extension_<appId sans tirets>_licenceOnboarding (requis avec LICENSES)

# Obligatoires au démarrage
UPN_DOMAIN=                # ex. contoso.com
# Nom complet de l'attribut d'extension (statutOnboarding : EnAttente | Validé | Refusé)
ENTRA_STATUS_EXTENSION=    # extension_<appId sans tirets>_statutOnboarding

# TAP : durée en minutes (10 à 43200, défaut 480), fenêtre de régénération en jours (défaut 7), fuseau du jour J
TAP_LIFETIME_MINUTES=       # TAP multi-usage, défaut 720 ; la politique TAP du tenant doit l'autoriser (durée maximale)
TAP_START_DELAY_MINUTES=    # délai avant que le TAP soit utilisable, défaut 5
ARRIVANTS_GROUP_ID=         # GUID du groupe des arrivants (ajout à l'activation, retrait à Terminé)
ENTRA_ACTIVATION_EXTENSION= # extension_<appId sans tirets>_activationOnboarding (date d'activation)
TZ_METIER=                 # défaut : Europe/Paris

# Rôle d'application (Easy Auth) requis pour les routes RH
RH_ROLE=RH

# Dev local uniquement (ignoré si NODE_ENV=production) : accepte l'en-tête X-MS-CLIENT-PRINCIPAL sans Easy Auth
ALLOW_INSECURE_DEV_AUTH=
# Journalisation Application Insights (sinon : JSON sur la console)
APPLICATIONINSIGHTS_CONNECTION_STRING=
